{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "firefox",
      "request": "launch",
      "name": "Quasar App: Firefox",
      "url": "http://localhost:9000",
      "webRoot": "${workspaceFolder}",
      "pathMappings": [
        {
          "url": "/src",
          "path": "${workspaceFolder}/src"
        },
        {
          "url": "http://localhost:9000/src",
          "path": "${workspaceFolder}/src"
        },
        {
          "url": "vite://",
          "path": "${workspaceFolder}"
        },
        {
          "url": "webpack://",
          "path": "${workspaceFolder}"
        }
      ],
      "reAttach": true
    }
  ]
}
